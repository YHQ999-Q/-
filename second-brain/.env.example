# 复制为 .env 后填写。三项都填才走真实模型；任意一项为空 → 自动离线 mock。
# DeepSeek
OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
MODEL=deepseek-chat

# 通义千问（DashScope 兼容模式）
# OPENAI_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL=qwen-plus
# Kimi（Moonshot）
# OPENAI_COMPATIBLE_BASE_URL=https://api.moonshot.cn/v1
# MODEL=moonshot-v1-32k

# 可选
# BEEAGENT_MOCK=1               # 有 key 也强制 mock
# BEEAGENT_DB=data/beeagent.db
# BEEAGENT_TZ=Asia/Shanghai
# BEEAGENT_USER_NAME=用户        # 摘要里对用户的称呼
# BEEAGENT_SILENCE_GAP_S=360     # 静音多少秒关会话（Bee ≈360；Omi 是 120）
# BEEAGENT_PREROLL_S=30          # 预录回填秒数
