# ==================================================================
# METAMIND · 根级环境变量模板
# 把本文件复制为 .env 并填写真实值。
# !! 警告：.env、真实密钥、真实数据库一律不入 Git（见 .gitignore）。
# !! 本仓库是公开的——永远只提交 .env.example 模板，不提交真实值。
# ==================================================================

# ------------------------------------------------------------------
# 1) OpenTutor 自进化底座（端口 8000）
#    —— 在 opentutor/ 下运行，详见 opentutor/.env.example
# 你只需配置一个主 LLM Provider。示例用 SiliconFlow / DeepSeek：
# ------------------------------------------------------------------
LLM_PROVIDER=deepseek            # openai|anthropic|deepseek|ollama|openrouter|...
LLM_MODEL=deepseek-chat
LLM_REQUIRED=true                # 生产 true；false 则无 Key 时走 mock 兜底
# 各厂商真实 key 放入 opentutor/.env（对应 providers）：
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_BASE_URL=
# CUSTOM_LLM_MODEL=

# JWT / 加密密钥：生产必须在 .env 里设置强随机值
# JWT_SECRET_KEY=
# ENCRYPTION_KEY=

# 数据库连接（默认 SQLite；生产可换 PostgreSQL）
# DATABASE_URL=sqlite+aiosqlite:///<abs>/opentutor.db

# ---- 运行时开关 ----
APP_AUTO_CREATE_TABLES=true
APP_AUTO_SEED_SYSTEM=false
APP_AUTO_SEED_DEMO=false
APP_RUN_SCHEDULER=false
APP_RUN_ACTIVITY_ENGINE=false

# CORS（前端地址）——本地开发默认开这两个
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ------------------------------------------------------------------
# 2) React 前端（端口 5173）——见 frontend/.env.example
#    学习助手 / 第二大脑 / 学习画像 页面的问答与采集能力
# ------------------------------------------------------------------
# DASHSCOPE_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus
# QWEN_ASR_MODEL=qwen3-asr-flash

# ------------------------------------------------------------------
# 3) 教学 Agent（端口 5001）——见 teaching/requirements.txt
#    拍照/录音/3题自测/知识图谱/策略版本
#    真实 LLM key 写入 teaching/.env 或环境变量（不要提交 api_key.txt）
# ------------------------------------------------------------------
# TEACHING_LLM_API_KEY=
# TEACHING_LLM_BASE_URL=
# TEACHING_LLM_MODEL=deepseek-chat

# ------------------------------------------------------------------
# 4) 第二大脑 Bee（端口/服务 见 second-brain/）——见 second-brain/.env.example
#    三项都填才走真实模型；空则默认离线 mock
# ------------------------------------------------------------------
# OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=
# MODEL=deepseek-chat
# BEEAGENT_MOCK=1     # 填 1 强制离线 mock

# ------------------------------------------------------------------
# 5) 部署（Vercel / Railway / Render）——见各子项目配置文件
#    Vercel 前端：frontend/ 构建，Vite 代理 /opentutor-api /teach-api
# ------------------------------------------------------------------
# 前端构建：
#   build:  npm run build
#   output: dist/  （Vercel 会自动识别）
